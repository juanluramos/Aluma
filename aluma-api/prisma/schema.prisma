generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Actividad {
  id_actividad         Int                    @id @default(autoincrement())
  titulo               String                 @db.VarChar(100)
  aforo                Int?
  fecha                DateTime?              @db.Date
  importeSocio         Decimal?               @db.Decimal(10, 2)
  importeNoSocio       Decimal?               @db.Decimal(10, 2)
  id_estado_actividad  Int
  comentario           String?                @db.Text
  createAt             DateTime               @default(now()) @db.DateTime(0)
  updateAt             DateTime               @default(now()) @db.DateTime(0)
  EstadoActividad      EstadoActividad        @relation(fields: [id_estado_actividad], references: [id_estado_actividad], onUpdate: Restrict, map: "fk_actividad_estado")
  InscripcionActividad InscripcionActividad[]

  @@index([id_estado_actividad], map: "fk_actividad_estado")
}

model CuentaAutenticacion {
  id_cuenta     Int      @id @default(autoincrement())
  id_usuario    Int
  proveedor     String   @db.VarChar(20)
  email         String   @db.VarChar(254)
  password_hash String?  @db.VarChar(255)
  external_id   String?  @db.VarChar(255)
  createAt      DateTime @default(now()) @db.DateTime(0)
  updateAt      DateTime @default(now()) @db.DateTime(0)
  Usuario       Usuario  @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_cuenta_usuario")

  @@unique([proveedor, external_id], map: "uq_cuenta_proveedor_external")
  @@index([id_usuario], map: "fk_cuenta_usuario")
}

model EstadoActividad {
  id_estado_actividad Int         @id @default(autoincrement())
  nombre_estado       String      @unique(map: "nombre_estado") @db.VarChar(15)
  Actividad           Actividad[]
}

model EstadoPago {
  id_estado_pago              Int                    @id @default(autoincrement())
  nombre_estado               String                 @unique(map: "nombre_estado") @db.VarChar(30)
  requiereDatosPago           Boolean                @default(false)
  id_tipo_movimiento_generado Int?
  TipoMovimiento              TipoMovimiento?        @relation(fields: [id_tipo_movimiento_generado], references: [id_tipo_movimiento], onDelete: Restrict, onUpdate: Restrict, map: "fk_estado_pago_tipo_movimiento")
  InscripcionActividad        InscripcionActividad[]

  @@index([id_tipo_movimiento_generado], map: "fk_estado_pago_tipo_movimiento")
}

model EstadoUsuario {
  id_estado_usuario  Int       @id @default(autoincrement())
  nombre_estado      String    @unique(map: "nombre_estado") @db.VarChar(30)
  descripcion        String?   @db.VarChar(100)
  permiteLogin       Boolean
  permiteInscripcion Boolean
  Usuario            Usuario[]
}

model InscripcionActividad {
  id_inscripcion        Int                  @id @default(autoincrement())
  id_usuario            Int
  id_actividad          Int
  precioAplicado        Decimal?             @db.Decimal(10, 2)
  id_estado_pago        Int
  id_estado_inscripcion Int
  id_metodo_pago        Int?
  apuntadoFecha         DateTime             @db.Date
  fechaPago             DateTime?            @db.Date
  comentario            String?              @db.Text
  createAt              DateTime             @default(now()) @db.DateTime(0)
  updateAt              DateTime             @default(now()) @db.DateTime(0)
  Actividad             Actividad            @relation(fields: [id_actividad], references: [id_actividad], onUpdate: Restrict, map: "fk_inscripcion_actividad")
  EstadoInscripcion     EstadoInscripcion    @relation(fields: [id_estado_inscripcion], references: [id_estado_inscripcion], onUpdate: Restrict, map: "fk_inscripcion_estado_inscripcion")
  EstadoPago            EstadoPago           @relation(fields: [id_estado_pago], references: [id_estado_pago], onUpdate: Restrict, map: "fk_inscripcion_estado_pago")
  MetodoPago            MetodoPago?          @relation(fields: [id_metodo_pago], references: [id_metodo_pago], onDelete: Restrict, onUpdate: Restrict, map: "fk_inscripcion_metodo_pago")
  Usuario               Usuario              @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_inscripcion_usuario")
  MovimientoContable    MovimientoContable[]

  @@index([id_actividad], map: "fk_inscripcion_actividad")
  @@index([id_estado_pago], map: "fk_inscripcion_estado_pago")
  @@index([id_metodo_pago], map: "fk_inscripcion_metodo_pago")
  @@index([id_estado_inscripcion], map: "fk_inscripcion_estado_inscripcion")
  @@index([id_usuario], map: "fk_inscripcion_usuario")
}

model MetodoPago {
  id_metodo_pago       Int                    @id @default(autoincrement())
  nombre               String                 @unique(map: "nombre_metodo") @db.VarChar(30)
  InscripcionActividad InscripcionActividad[]
}

model MovimientoContable {
  id_movimiento        Int                   @id @default(autoincrement())
  id_tipo_movimiento   Int
  concepto             String                @db.VarChar(25)
  importe              Decimal               @db.Decimal(10, 2)
  fecha                DateTime              @db.DateTime(0)
  id_inscripcion       Int?
  comentario           String?               @db.Text
  createAt             DateTime              @default(now()) @db.DateTime(0)
  updateAt             DateTime              @default(now()) @db.DateTime(0)
  InscripcionActividad InscripcionActividad? @relation(fields: [id_inscripcion], references: [id_inscripcion], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimiento_inscripcion")
  TipoMovimiento       TipoMovimiento        @relation(fields: [id_tipo_movimiento], references: [id_tipo_movimiento], onUpdate: Restrict, map: "fk_movimiento_tipo")

  @@index([id_inscripcion], map: "fk_movimiento_inscripcion")
  @@index([id_tipo_movimiento], map: "fk_movimiento_tipo")
}

model RolUsuario {
  id_rol     Int       @id @default(autoincrement())
  nombre_rol String    @unique(map: "nombre_rol") @db.VarChar(30)
  Usuario    Usuario[]
}

model TipoDocumentoIdentificacion {
  SolicitudAlta SolicitudAlta[]
  id_tipo_documento Int       @id @default(autoincrement())
  nombre            String    @unique(map: "nombre") @db.VarChar(30)
  Usuario           Usuario[]
}

model TipoMovimiento {
  id_tipo_movimiento Int                  @id @default(autoincrement())
  nombre             String               @unique(map: "nombre") @db.VarChar(30)
  createAt           DateTime             @default(now()) @db.DateTime(0)
  updateAt           DateTime             @default(now()) @db.DateTime(0)
  EstadoPago         EstadoPago[]
  MovimientoContable MovimientoContable[]
}

model Usuario {
  SesionesAutenticacion SesionAutenticacion[]
  SolicitudesResueltas SolicitudAlta[] @relation("AdministradorSolicitud")
  SolicitudOrigen SolicitudAlta? @relation("UsuarioSolicitud")
  id_usuario                  Int                         @id @default(autoincrement())
  codUsuario                  String?                     @unique(map: "codUsuario") @db.VarChar(10)
  id_tipo_documento           Int
  numeroDocumento             String                      @unique(map: "numeroDocumento") @db.VarChar(20)
  nombre                      String                      @db.VarChar(50)
  apellido1                   String?                     @db.VarChar(50)
  apellido2                   String?                     @db.VarChar(50)
  email                       String                      @unique(map: "uq_usuario_email") @db.VarChar(254)
  telefono                    String?                     @db.VarChar(15)
  id_rol                      Int
  socio                       Boolean
  id_estado_usuario           Int
  matriculaPagada             Boolean
  comentario                  String?                     @db.Text
  createAt                    DateTime                    @default(now()) @db.DateTime(0)
  updateAt                    DateTime                    @default(now()) @db.DateTime(0)
  CuentaAutenticacion         CuentaAutenticacion[]
  InscripcionActividad        InscripcionActividad[]
  EstadoUsuario               EstadoUsuario               @relation(fields: [id_estado_usuario], references: [id_estado_usuario], onUpdate: Restrict, map: "fk_usuario_estado")
  RolUsuario                  RolUsuario                  @relation(fields: [id_rol], references: [id_rol], onUpdate: Restrict, map: "fk_usuario_rol")
  TipoDocumentoIdentificacion TipoDocumentoIdentificacion @relation(fields: [id_tipo_documento], references: [id_tipo_documento], onUpdate: Restrict, map: "fk_usuario_tipo_documento")

  @@index([id_estado_usuario], map: "fk_usuario_estado")
  @@index([id_rol], map: "fk_usuario_rol")
  @@index([id_tipo_documento], map: "fk_usuario_tipo_documento")
}

model SesionAutenticacion {
  id             String   @id @db.Char(36)
  id_usuario     Int
  refreshHash    String   @unique @db.Char(64)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  lastActivityAt DateTime @db.DateTime(3)
  expiresAt      DateTime @db.DateTime(3)
  revokedAt      DateTime? @db.DateTime(3)
  Usuario        Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: Restrict)

  @@index([id_usuario])
  @@index([expiresAt])
}

model EstadoInscripcion {
  id_estado_inscripcion Int                    @id @default(autoincrement())
  nombre                String                 @unique(map: "nombre") @db.VarChar(30)
  createAt              DateTime               @default(now()) @db.DateTime(0)
  updateAt              DateTime               @default(now()) @db.DateTime(0)
  InscripcionActividad  InscripcionActividad[]
}

model Auditoria {
  id_auditoria BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fecha_evento DateTime @default(now()) @db.DateTime(3)
  requestId    String   @db.Char(36)
  id_usuario   Int?
  rol_actor    String?  @db.VarChar(30)
  accion       String   @db.VarChar(64)
  recurso      String   @db.VarChar(32)
  id_recurso   Int?
  resultado    String   @db.VarChar(16)
  codigo_error String?  @db.VarChar(64)
  detalles     Json?

  @@index([fecha_evento, id_auditoria], map: "idx_auditoria_fecha")
  @@index([id_usuario, fecha_evento, id_auditoria], map: "idx_auditoria_usuario_fecha")
  @@index([recurso, id_recurso, fecha_evento, id_auditoria], map: "idx_auditoria_recurso_fecha")
  @@index([accion, fecha_evento, id_auditoria], map: "idx_auditoria_accion_fecha")
  @@index([requestId, id_auditoria], map: "idx_auditoria_request")
}

model EstadoSolicitud {
  id_estado_solicitud Int @id @default(autoincrement())
  nombre String @unique @db.VarChar(20)
  SolicitudAlta SolicitudAlta[]
}

model SolicitudAlta {
  id_solicitud Int @id @default(autoincrement())
  proveedor String @db.VarChar(20)
  external_id String @db.VarChar(255)
  email String @db.VarChar(254)
  id_tipo_documento Int
  numeroDocumento String @db.VarChar(20)
  nombre String @db.VarChar(50)
  apellido1 String? @db.VarChar(50)
  apellido2 String? @db.VarChar(50)
  telefono String? @db.VarChar(15)
  socio Boolean
  id_estado_solicitud Int
  fechaSolicitud DateTime @default(now()) @db.DateTime(3)
  fechaResolucion DateTime? @db.DateTime(3)
  id_administrador_resolucion Int?
  motivoRechazo String? @db.VarChar(500)
  id_usuario_creado Int? @unique
  EstadoSolicitud EstadoSolicitud @relation(fields: [id_estado_solicitud], references: [id_estado_solicitud], onDelete: Restrict, onUpdate: Restrict)
  TipoDocumentoIdentificacion TipoDocumentoIdentificacion @relation(fields: [id_tipo_documento], references: [id_tipo_documento], onDelete: Restrict, onUpdate: Restrict)
  AdministradorResolucion Usuario? @relation("AdministradorSolicitud", fields: [id_administrador_resolucion], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict)
  UsuarioCreado Usuario? @relation("UsuarioSolicitud", fields: [id_usuario_creado], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict)
  @@unique([proveedor, external_id], map: "uq_solicitud_proveedor_external")
  @@index([id_estado_solicitud, fechaSolicitud])
}
