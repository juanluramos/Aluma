# Aplicación. Estos valores no los usan las pruebas de integración.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=aluma
DATABASE_URL=mysql://USUARIO:CLAVE@HOST:3306/aluma

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Pruebas de integración. El nombre tiene que ser exactamente aluma_test.
# No reutilices la contraseña en este archivo de ejemplo.
# Preparar la base, cuando esté autorizado:
# ALUMA_AUTORIZAR_ALUMA_TEST=1 sh scripts/preparar-aluma-test.sh
# ALUMA_AUTORIZAR_ALUMAT_TEST sigue siendo válido.
# Las pruebas de integración sobre aluma no forman parte de npm test.
# Requieren ALUMA_AUTORIZAR_PRUEBAS_ALUMA=1 y se lanzan con npm run test:integracion.
DATABASE_TEST_HOST=
DATABASE_TEST_PORT=3306
DATABASE_TEST_USER=
DATABASE_TEST_PASSWORD=
DATABASE_TEST_NAME=aluma_test
DATABASE_TEST_URL=mysql://USUARIO:CLAVE@HOST:3306/aluma_test
